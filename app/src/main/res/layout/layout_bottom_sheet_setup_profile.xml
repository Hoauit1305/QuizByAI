<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#555555" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Set Up Profile"
        android:textAlignment="center"
        android:textColor="@color/primary_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Let everyone know who you are!"
        android:textAlignment="center"
        android:textColor="@color/secondary_white"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edt_setup_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_rounded_card"
        android:hint="Display Name"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:textColor="@color/primary_white"
        android:textColorHint="@color/secondary_white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="Choose your Avatar"
        android:textColor="@color/primary_white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/avatar_option_1"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginHorizontal="10dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/icon_avata_1" />

        <ImageButton
            android:id="@+id/avatar_option_2"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginHorizontal="10dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/icon_avata_2" />

        <ImageButton
            android:id="@+id/avatar_option_3"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginHorizontal="10dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/icon_avata_3" />

        <ImageButton
            android:id="@+id/avatar_option_4"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginHorizontal="10dp"
            android:background="@android:color/transparent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/icon_avata_4" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_setup_save"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="@color/primary_orange"
        android:text="Save &amp; Continue"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>